# Подключение к Postgres (docker-compose: postgres/postgres@localhost:5434/iconic_invitation)
# Хост-порт 5434 (не 5432/5433 — заняты другими локальными проектами).
# DATABASE_URL — читает drizzle-kit (миграции/seed), NUXT_DATABASE_URL — читает Nuxt runtime.
# Оба должны указывать на одну и ту же БД.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/iconic_invitation
NUXT_DATABASE_URL=postgres://postgres:postgres@localhost:5434/iconic_invitation

# Пароль админки и секрет для подписи сессионной cookie (SESSION_SECRET — минимум 32 символа)
NUXT_ADMIN_PASSWORD=changeme
NUXT_SESSION_SECRET=changeme-session-secret-min-32-chars

# Часовой пояс мероприятия (раздел 7 ТЗ)
NUXT_PUBLIC_EVENT_TIMEZONE=Asia/Dubai
